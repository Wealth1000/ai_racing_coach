/target
/target_head

# Telemetry captures — these are large (tens of MB per session) and are
# regenerated by the logger, so they must never enter git history.
*.ndjson
*.ndjson.gz
*.meta.json
/ndjson data/

# Test fixtures are small, hand-sliced excerpts of real captures and MUST be
# committed — they are the regression corpus. Re-include them after the rules
# above. (Negation only works because no *parent directory* is excluded.)
!tests/fixtures/*.ndjson
!tests/fixtures/*.ndjson.gz
!tests/fixtures/*.meta.json

# Analysis scratch output
corners.txt
curvature_profile.txt

# A stray copy of the built binary once landed in the repo root (someone ran
# cargo with an overridden target dir); keep it out rather than re-deleting it.
/coach
